# data artifacts — raw snapshots and the DuckDB build are local; schema/code is enough
db/raw/
db/projections/
db/*.duckdb
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
db/backtest/

# fetched external season archives (regenerable via fpl_claude.backtest.fetch)
db/vaastav/

# trained model artifacts — retrainable from the archives with a fixed seed;
# the committed metrics JSON is what makes the results auditable without them
db/models/
